# AETHRA AI — environment configuration
# All configuration and secrets are read from environment variables only.
# Never hardcode secrets in source files, and never commit real values here.
# Copy this file to .env (gitignored) and fill in local values.

# --- Storage (durable persistence) ---------------------------------------
# Two drivers share one schema (see src/lib/storage/migrations.ts):
#
#   AETHRA_STORAGE=sqlite    (default) local SQLite file. Survives server
#                            restarts on a single host (the systemd deploy).
#   AETHRA_STORAGE=postgres  shared Postgres database. Survives restarts,
#                            serverless cold starts, and multiple app
#                            instances. Requires DATABASE_URL.
AETHRA_STORAGE=sqlite

# Path to the SQLite database file (durable persistence).
# Defaults to <project-root>/.data/aethra.db when unset.
AETHRA_DB_PATH=.data/aethra.db

# Required when AETHRA_STORAGE=postgres. The synchronous DAO layer
# (src/lib/db.ts) is SQLite-only and fails fast in postgres mode; the async
# StorageDriver interface (src/lib/storage) is the Postgres path.
# DATABASE_URL=postgres://user:password@host:5432/aethra

# --- Live discovery (AI Security persona) --------------------------------
# Only allowlisted sources are ever fetched; see src/lib/discovery/adapters.
# All overrides are optional.
#
# arXiv query phrases (space-separated quoted phrases are built internally; this
# string is sanitized to letters/digits/spaces):
# AETHRA_ARXIV_QUERY=adversarial machine learning,prompt injection,AI safety
#
# GitHub owner/repo allowlist for the releases feed (comma-separated):
# AETHRA_GITHUB_REPOS=ollama/ollama,huggingface/transformers,langchain-ai/langchain
#
# AI-lab RSS/Atom feeds allowlist (comma-separated https URLs only):
# AETHRA_LAB_FEEDS=https://openai.com/news/rss.xml,https://security.googleblog.com/feeds/posts/default
#
# Source health & freshness (persisted in the source_health table):
#   - A source is STALE when its last successful fetch is older than this
#     (ms; default 7 days).
# AETHRA_SOURCE_STALE_MS=604800000
#
# Source diversity rules (the AI Security feed must not be dominated by one
# source type):
#   - Max candidates from ONE source type per editorial run (intake diversity;
#     default 6).
# AETHRA_DISCOVERY_MAX_PER_SOURCE=6
#   - Max posts from ONE source type in the rolling 24h window (feed diversity;
#     default 2). Verified breaking-security items are exempt.
# AETHRA_DIVERSITY_MAX_POSTS_PER_TYPE=2

# --- Durable orchestration (external cron/queue) --------------------------
# Recurring work is scheduled durably in SQLite and driven ONLY by an external
# scheduler — never by setInterval or an API GET. Two triggers are provided:
#
#   1. POST /api/cron/run  (systemd timer webhook — see deploy/)
#   2. npm run worker      (one-shot CLI for a cron line / CI schedule)
#
# Secret for the cron webhook. REQUIRED in production: the committed systemd
# timer (deploy/aethra-cron.service) sends it as `Authorization: Bearer
# <secret>` and the route rejects requests without it (401). When unset (local
# dev), the Vercel Cron header (x-vercel-cron: 1) is required instead.
# AETHRA_CRON_SECRET=
#
# Accelerated 48-hour simulation mode for automated tests. Compresses the
# recurring schedule interval by this factor (e.g. 60 → a 30-min cadence runs
# every 30s). Unset in production; production behavior is unchanged when absent.
# AETHRA_SIM_ACCELERATION=

# --- LLM post generation (server-side) ----------------------------------
# Keys come from the environment (e.g. a deployment secret), never from code.
#
# Provider mode:
#   local   — deterministic, offline, schema-valid output (the TEST/offline
#             provider). No API key required. Never deploy with this.
#   openai  — OpenAI-compatible /chat/completions endpoint (production).
#   unset   — auto: openai when AETHRA_LLM_API_KEY is present (or
#             NODE_ENV=production); local otherwise (dev/tests without a key).
#             NODE_ENV=production without a key yields a FAILING provider —
#             production never silently falls back to deterministic output.
# AETHRA_LLM_PROVIDER=local
#
# Required when AETHRA_LLM_PROVIDER=openai (or auto in production):
# AETHRA_LLM_API_KEY=sk-...
#
# Optional overrides for the OpenAI-compatible provider:
# AETHRA_LLM_BASE_URL=https://api.openai.com/v1
# AETHRA_LLM_MODEL=gpt-4o-mini
# AETHRA_LLM_TIMEOUT_MS=30000

# --- Semantic duplicate detection (optional embeddings) --------------------
# The duplicate ladder always runs its deterministic checks first (canonical
# URL → normalized title → keyword/topic overlap). The optional embeddings
# step (level 4) catches paraphrases and near-duplicates the lexical checks
# miss; when embeddings are unavailable or fail, the ladder degrades safely
# back to the deterministic checks.
#
#   AETHRA_SIMILARITY=auto (default) → embeddings when a key is configured,
#                                     lexical otherwise
#   AETHRA_SIMILARITY=embeddings     → embeddings (without a key this falls
#                                     back to lexical, never a crash)
#   AETHRA_SIMILARITY=lexical        → deterministic lexical only
# AETHRA_SIMILARITY=auto
#
# Embeddings endpoint (AETHRA_EMBEDDINGS_* override their AETHRA_LLM_*
# counterparts, so one deployment can serve both chat and embeddings):
# AETHRA_EMBEDDINGS_API_KEY=sk-...
# AETHRA_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# AETHRA_EMBEDDINGS_MODEL=text-embedding-3-small
# AETHRA_EMBEDDINGS_TIMEOUT_MS=30000
